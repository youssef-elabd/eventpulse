NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (keep the real one only in .env, never commit it)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventpulse

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000
